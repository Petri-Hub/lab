# Image published by the pepper repository; pin a commit tag to hold a version.
LEMON_SANDBOX_IMAGE=ghcr.io/petri-hub/lemon-sandbox:latest
LEMON_SANDBOX_TZ=America/Sao_Paulo

# Open Cloud key for the game's regression tests. It reaches every command in
# the container as JEST_ROBLOX_*, the names the project's Makefile exports, so
# no checkout needs to hold a copy.
LEMON_OPEN_CLOUD_API_KEY=your-open-cloud-api-key
LEMON_OPEN_CLOUD_UNIVERSE_ID=1234567890
LEMON_OPEN_CLOUD_PLACE_ID=987654321098
