# Mint's OpenAI-compatible API, for Home Assistant's Hermes Voice integration.
# Only /v1 is published, mapped onto Mint's /p/mint/ prefix in the multiplexed
# gateway, so Pepper and Lemon stay unreachable here. Hermes checks Mint's own
# API_SERVER_KEY on every request; Cloudflare Access is bypassed for /v1 only.
server {
    listen 80;
    server_name ${NGINX_MINT_DOMAIN};

    location /v1/ {
        set $upstream_mint http://hermes:8642;
        rewrite ^/v1/(.*)$ /p/mint/v1/$1 break;
        proxy_pass $upstream_mint;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Replies stream as server-sent events, and a turn with tools can run for minutes.
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location / {
        return 404;
    }
}
